---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import { liveSections } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  image?: { url: string; alt: string };
}
const { title, description, canonical, ogType = 'website', jsonLd, noindex = false, image } = Astro.props;
const ogImage = image ? new URL(image.url, Astro.site).href : new URL('/og-default.png', Astro.site).href;
const url = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const SITE_NAME = 'ScoreRadar';
// Append the brand only if the full <title> stays within ~60 chars (Google truncates longer titles)
const fullTitle = title.includes(SITE_NAME) || `${title} | ${SITE_NAME}`.length > 60 ? title : `${title} | ${SITE_NAME}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const live = new Set(await liveSections());
// Results link only when a results file exists (never link to an empty page).
const resultFiles = import.meta.glob('../data/results.json', { eager: true }) as Record<string, any>;
const hasResults = Object.keys(resultFiles).length > 0;
// Articles come first (they are the core of the site), the prediction game follows.
const nav = [
  ...[['guides', 'Guides'], ['analysis', 'Match Analysis'], ['news', 'News']].filter(([k]) => live.has(k as any)).map(([k, l]) => ['/' + k, l]),
  ...(hasResults ? [['/results', 'Results']] : []),
  ['/predict', 'Predict'],
  ['/leaderboard', 'Leaderboard'],
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta name="theme-color" content="#0b6e4f" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={ogImage} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    {image && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="ScoreRadar" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...o })} />)}
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && <meta name="google-adsense-account" content={import.meta.env.PUBLIC_ADSENSE_CLIENT} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2 focus:text-ink">Skip to content</a>
    <header class="sticky top-0 z-40 bg-ink text-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2.5">
        <a href="/" class="flex items-center gap-2.5" aria-label="ScoreRadar home">
          <img src="/logo.png" alt="" width="30" height="30" class="rounded-[5px]" />
          <span class="display text-[1.7rem] font-extrabold uppercase leading-none tracking-wide">Score<span class="text-gold">Radar</span></span>
        </a>
        <nav aria-label="Main" class="display flex flex-wrap gap-x-6 gap-y-1 text-[1.1rem] font-semibold uppercase tracking-wider">
          {nav.map(([href, label]) => {
            const on = here === href || here.startsWith(href + '/');
            return <a href={href} class={`border-b-[3px] py-0.5 hover:border-gold/60 ${on ? 'border-gold text-white' : 'border-transparent text-slate-300'}`} aria-current={on ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1 mx-auto w-full max-w-6xl px-4 py-8"><slot /></main>
    <footer class="mt-8 border-t-[6px] border-gold bg-ink text-sm text-slate-300">
      <div class="mx-auto max-w-6xl px-4 py-8 grid gap-6 sm:grid-cols-3">
        <div>
          <p class="display text-2xl font-extrabold uppercase tracking-wide text-white">Score<span class="text-gold">Radar</span></p>
          <p class="mt-2">Data-driven football predictions, match analysis and guides, plus a free score-prediction game.</p>
        </div>
        <ul class="space-y-1">
          <li><a href="/about" class="hover:text-white">About Us</a></li>
          <li><a href="/author" class="hover:text-white">Author & Editor</a></li>
          <li><a href="/methodology" class="hover:text-white">Prediction Methodology</a></li>
          <li><a href="/editorial-policy" class="hover:text-white">Editorial Policy</a></li>
          <li><a href="/contact" class="hover:text-white">Contact</a></li>
        </ul>
        <ul class="space-y-1">
          <li><a href="/privacy" class="hover:text-white">Privacy Policy</a></li>
          <li><a href="/cookies" class="hover:text-white">Cookie Policy</a></li>
          <li><a href="/terms" class="hover:text-white">Terms of Use</a></li>
          <li><a href="/responsible-play" class="hover:text-white">Responsible Play</a></li>
          <li><a href="/accessibility" class="hover:text-white">Accessibility</a></li>
          <li><a href="/site-map" class="hover:text-white">Site Map</a></li>
          <li><button id="open-consent" type="button" class="hover:text-white underline">Cookie settings</button></li>
        </ul>
      </div>
      <p class="border-t border-slate-700 py-4 text-center text-xs">© {new Date().getFullYear()} {SITE_NAME}. Not betting advice; for information and entertainment only.</p>
    </footer>
    <ConsentBanner />
  </body>
</html>
