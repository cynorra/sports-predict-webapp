---
import Base from './Base.astro';
import { SECTIONS } from '../lib/sections';
import { relatedPosts } from '../lib/site';

interface Props {
  title: string;
  description: string;
  answer: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  image: { src: string; alt: string };
  section: 'analysis' | 'news' | 'guides';
  faq?: { q: string; a: string }[];
  headings?: { depth: number; slug: string; text: string }[];
  slug?: string;
  match?: {
    homeTeam: string;
    awayTeam: string;
    homeCrest?: string;
    awayCrest?: string;
    competition: string;
    kickoff: Date;
    prediction: {
      home: number;
      away: number;
      pHome: number;
      pDraw: number;
      pAway: number;
    };
  };
}
const { title, description, answer, publishedAt, updatedAt, author, image, section, faq = [], headings = [], match, slug = '' } = Astro.props;
const related = await relatedPosts(section, slug, 3);
const sectionTitle = SECTIONS[section].title;
const toc = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogPng = image.src.replace(/\.svg$/, '.png'); // generated twin: social networks do not render SVG

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': section === 'news' ? 'NewsArticle' : 'Article',
    headline: title,
    description,
    image: [new URL(ogPng, Astro.site).href],
    datePublished: publishedAt.toISOString(),
    dateModified: (updatedAt ?? publishedAt).toISOString(),
    author: {
      '@type': 'Person',
      name: author,
      url: new URL('/author/', Astro.site).href,
    },
    publisher: { '@type': 'Organization', name: 'Soccer Games Today', logo: { '@type': 'ImageObject', url: new URL('/logo.png', Astro.site).href } },
    mainEntityOfPage: url,
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: sectionTitle, item: new URL(`/${section}`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
if (faq.length) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Base title={title} description={description} ogType="article" jsonLd={jsonLd} image={{ url: ogPng, alt: image.alt }}>
  <div class="grid gap-8 lg:grid-cols-[1fr_300px]">
    <article>
      <nav aria-label="Breadcrumb" class="mb-3 text-sm text-slate-500">
        <a href="/" class="hover:underline">Home</a> <span aria-hidden="true">/</span> <a href={`/${section}`} class="hover:underline">{sectionTitle}</a>
      </nav>
      <h1 class="text-5xl font-extrabold leading-[0.95] sm:text-6xl">{title}</h1>
      <p class="mt-2 text-sm text-slate-500">
        By <a href="/author" class="font-medium text-slate-700 hover:text-pitch hover:underline">{author}</a> · Published: <time datetime={publishedAt.toISOString()}>{fmt(publishedAt)}</time>
        {updatedAt && <>· Updated: <time datetime={updatedAt.toISOString()}>{fmt(updatedAt)}</time></>}
      </p>

      <img src={image.src} alt={image.alt} width="1200" height="630" fetchpriority="high" decoding="async" class="mt-5 w-full border border-line" />

      {match && (
        <div class="mt-5 overflow-hidden bg-ink p-5 text-white">
          <div class="flex flex-wrap items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-300">
            <span>{match.competition}</span>
            <span>Kickoff: {match.kickoff.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC' })} UTC</span>
          </div>
          <div class="mt-4 flex items-center justify-around text-center">
            <div class="flex flex-1 flex-col items-center gap-2">
              {match.homeCrest && <img src={match.homeCrest} alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-14 w-14 object-contain" />}
              <p class="display text-2xl font-bold leading-none sm:text-3xl">{match.homeTeam}</p>
              <span class="text-xs text-slate-400">Home</span>
            </div>
            <div class="mx-3 flex flex-col items-center">
              <div class="digit border border-white/20 px-4 py-1 text-4xl tracking-widest">
                {match.prediction.home} - {match.prediction.away}
              </div>
              <span class="mt-1 text-[11px] font-semibold uppercase tracking-wider text-gold">Model Scoreline</span>
            </div>
            <div class="flex flex-1 flex-col items-center gap-2">
              {match.awayCrest && <img src={match.awayCrest} alt="" width="56" height="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-14 w-14 object-contain" />}
              <p class="display text-2xl font-bold leading-none sm:text-3xl">{match.awayTeam}</p>
              <span class="text-xs text-slate-400">Away</span>
            </div>
          </div>
          <div class="mt-4 border-t border-slate-700/80 pt-3">
            <p class="mb-2 text-center text-xs font-medium text-slate-400">Model Outcome Probabilities (Elo + Poisson)</p>
            <div class="grid grid-cols-3 gap-2 text-center text-xs">
              <div class="rounded bg-slate-800/80 p-2">
                <p class="text-slate-400">{match.homeTeam} Win</p>
                <p class="text-base font-bold text-white">{Math.round(match.prediction.pHome * 100)}%</p>
              </div>
              <div class="rounded bg-slate-800/80 p-2">
                <p class="text-slate-400">Draw</p>
                <p class="text-base font-bold text-white">{Math.round(match.prediction.pDraw * 100)}%</p>
              </div>
              <div class="rounded bg-slate-800/80 p-2">
                <p class="text-slate-400">{match.awayTeam} Win</p>
                <p class="text-base font-bold text-white">{Math.round(match.prediction.pAway * 100)}%</p>
              </div>
            </div>
          </div>
          <div class="mt-4 text-center">
            <a href="/predict" class="inline-block bg-gold px-4 py-2 text-xs font-bold uppercase tracking-wider text-ink hover:bg-yellow-400">
              Submit Your Own Prediction →
            </a>
          </div>
        </div>
      )}

      <!-- Short answer: clear answer up top for AI overviews / featured snippets -->
      <aside class="mt-5 card border-l-4 !border-l-pitch p-4">
        <p class="text-xs font-bold uppercase tracking-wide text-pitch">In short</p>
        <p class="mt-1">{answer}</p>
      </aside>
      {toc.length >= 3 && (
        <nav aria-label="Table of contents" class="mt-5 card p-4">
          <p class="text-xs font-bold uppercase tracking-wide text-slate-500">In this article</p>
          <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm">
            {toc.map((h) => <li><a class="text-pitch underline" href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="prose prose-slate mt-6 max-w-none prose-headings:scroll-mt-20"><slot /></div>
      {faq.length > 0 && (
        <section class="mt-10">
          <h2 class="rule-title text-4xl font-extrabold uppercase">Frequently asked questions</h2>
          <div class="mt-3 space-y-4">
            {faq.map((f) => (
              <div class="card p-4">
                <h3 class="display text-xl font-bold">{f.q}</h3>
                <p class="mt-1 text-slate-700">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}
      {related.length > 0 && (
        <section class="mt-10" aria-labelledby="related">
          <h2 id="related" class="rule-title text-4xl font-extrabold uppercase">Keep reading</h2>
          <ul class="mt-3 grid gap-4 sm:grid-cols-3">
            {related.map(({ section: s, entry }) => (
              <li class="card card-link p-4">
                <a href={`/${s}/${entry.id}`}>
                  <p class="text-xs font-bold uppercase tracking-wide text-pitch">{SECTIONS[s].title}</p>
                  <p class="mt-1 font-semibold leading-snug">{entry.data.title}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
    <aside class="space-y-4 lg:sticky lg:top-20 lg:self-start">
      <a href="/predict" class="block border-t-4 border-gold bg-ink p-5 text-white hover:bg-pitch-dark">
        <p class="display text-3xl font-extrabold uppercase leading-none">Make your own prediction <span aria-hidden="true">→</span></p>
        <p class="text-sm opacity-90">Enter your score, earn points, beat your friends.</p>
      </a>
      <!-- Ad slot: after approval put <ins class="adsbygoogle"> here -->
    </aside>
  </div>
</Base>
