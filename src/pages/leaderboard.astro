---
import Base from '../layouts/Base.astro';
---

<Base
  title="Prediction Leaderboard"
  description="Weekly and all-time rankings for the SkorRadar football score prediction game, plus private leagues for you and your friends."
>
  <h1 class="text-3xl font-extrabold">Leaderboard</h1>
  <p class="mt-2 max-w-2xl text-slate-600">
    Rankings open once sign-in is live. Points: exact score 10, correct result and goal difference 5, correct result 3.
    Start by making your picks on the <a class="font-semibold text-pitch underline" href="/predict">prediction page</a>.
  </p>
</Base>
