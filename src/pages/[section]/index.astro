---
import { getCollection } from 'astro:content';
import SectionList from '../../components/SectionList.astro';
import GuidesHub from '../../components/GuidesHub.astro';
import { SECTIONS, isLive, type Section } from '../../lib/sections';
import { PAGE_SIZE } from '../../lib/site';

// Sections without a live post get no page at all (an empty listing is thin content and a dead end).
export async function getStaticPaths() {
  const paths = [];
  for (const section of Object.keys(SECTIONS) as Section[]) {
    const entries = (await getCollection(section, isLive)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
    if (!entries.length) continue;
    // Guides are one topic-grouped hub with every guide on a single page, so they are not paginated.
    const hub = section === 'guides';
    paths.push({ params: { section }, props: { ...SECTIONS[section], section, entries: hub ? entries : entries.slice(0, PAGE_SIZE), totalPages: hub ? 1 : Math.ceil(entries.length / PAGE_SIZE) } });
  }
  return paths;
}
const props = Astro.props;
---

{props.section === 'guides' ? <GuidesHub entries={props.entries} /> : <SectionList {...props} page={1} />}
