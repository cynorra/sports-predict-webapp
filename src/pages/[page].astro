---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('pages')).map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.description}>
  <article class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-extrabold">{d.title}</h1>
    <p class="mt-1 text-sm text-slate-500">Last updated: {d.updatedAt.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
    <div class="prose prose-slate mt-6 max-w-none"><Content /></div>
  </article>
</Base>
