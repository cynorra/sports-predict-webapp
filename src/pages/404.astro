---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found" description="The page you asked for does not exist. Browse our soccer guides, match analysis and the score prediction game." noindex>
  <section class="mx-auto max-w-2xl py-10">
    <p class="kicker">Error 404</p>
    <h1 class="hero-num mt-2">Offside.<br /><span class="hl">Page not found.</span></h1>
    <p class="mt-6 text-lg text-slate-700">It may have moved or may not be published yet. Try one of these instead:</p>
    <ul class="display mt-4 divide-y divide-line border-y border-line text-2xl font-bold uppercase">
      <li><a class="flex justify-between py-3 hover:text-pitch" href="/guides">Guides <span aria-hidden="true">→</span></a></li>
      <li><a class="flex justify-between py-3 hover:text-pitch" href="/analysis">Match analysis <span aria-hidden="true">→</span></a></li>
      <li><a class="flex justify-between py-3 hover:text-pitch" href="/predict">Score prediction game <span aria-hidden="true">→</span></a></li>
      <li><a class="flex justify-between py-3 hover:text-pitch" href="/">Home page <span aria-hidden="true">→</span></a></li>
    </ul>
  </section>
</Base>
