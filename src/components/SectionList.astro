---
import Base from '../layouts/Base.astro';
import type { Section } from '../lib/sections';

interface Props { section: Section; title: string; blurb: string; entries: any[]; page: number; totalPages: number }
const { section, title, blurb, entries, page, totalPages } = Astro.props;
const href = (n: number) => (n === 1 ? `/${section}` : `/${section}/page/${n}`);
const heading = page > 1 ? `${title}, page ${page}` : title;
---

<Base title={heading} description={blurb}>
  <p class="kicker">ScoreRadar</p>
  <h1 class="mt-1 text-6xl font-extrabold uppercase">{heading}</h1>
  <p class="mt-3 max-w-2xl text-lg text-slate-700">{blurb}</p>
  <div class="mt-6 border-t-[3px] border-ink"></div>
  <ul class="mt-6 grid gap-5 sm:grid-cols-2">
    {entries.map((e) => (
      <li class="card card-link overflow-hidden">
        <a href={`/${section}/${e.id}`} class="block">
          <img src={e.data.image.src} alt="" width="1200" height="630" loading="lazy" decoding="async" class="aspect-[1200/630] w-full border-b border-line" />
          <div class="p-5">
            <h2 class="card-title display text-[1.65rem] font-bold leading-tight">{e.data.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{e.data.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
  {totalPages > 1 && (
    <nav aria-label="Pagination" class="mt-8 flex items-center justify-between text-sm font-semibold">
      {page > 1 ? <a href={href(page - 1)} rel="prev" class="text-pitch hover:underline">← Newer</a> : <span />}
      <span class="text-slate-500">Page {page} of {totalPages}</span>
      {page < totalPages ? <a href={href(page + 1)} rel="next" class="text-pitch hover:underline">Older →</a> : <span />}
    </nav>
  )}
</Base>
