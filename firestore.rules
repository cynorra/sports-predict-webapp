rules_version = '2';

// Paste into Firebase console -> Firestore Database -> Rules -> Publish (or deploy with the Firebase CLI).
//
// Trust model
//  - fixtures/*      written ONLY by the refresh workflow (service account bypasses rules). Clients can read, never write.
//                    The prediction lock is checked against this server-written kickoff, so it cannot be faked from the browser.
//  - predictions/*   one document per user per match, readable and writable only by its owner, only before kickoff.
//  - users/*         the owner's own profile (nickname). Never readable by others.
//  - leaderboard/*   public read, written ONLY by the scoring workflow (service account). No client writes.
//  - everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validScore(v) { return v is int && v >= 0 && v <= 20; }

    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if false;
    }

    match /predictions/{predictionId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'fixtureId', 'home', 'away', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.fixtureId is string
        && predictionId == request.auth.uid + '_' + request.resource.data.fixtureId
        && validScore(request.resource.data.home)
        && validScore(request.resource.data.away)
        && request.resource.data.updatedAt == request.time
        && request.time < get(/databases/$(database)/documents/fixtures/$(request.resource.data.fixtureId)).data.kickoff;

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'fixtureId', 'home', 'away', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.fixtureId == resource.data.fixtureId
        && validScore(request.resource.data.home)
        && validScore(request.resource.data.away)
        && request.resource.data.updatedAt == request.time
        && request.time < get(/databases/$(database)/documents/fixtures/$(resource.data.fixtureId)).data.kickoff;

      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
