# Copy to .env for local use. .env is gitignored. NEVER put real server-side secrets in this example file.
# In production, set these as host environment variables (and GitHub Actions secrets for CI jobs).

# football-data.org API token (server-side only: used by scripts/sync-fixtures.mjs, never shipped to the browser)
FOOTBALL_DATA_TOKEN=

# Firebase web config (public by design - it is visible in the browser; firestore.rules is what protects the data)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Public values (visible in the page source by design). Leave empty until AdSense is approved.
PUBLIC_ADSENSE_CLIENT=
SITE_URL=
